# 크롤 대상 설정
LIST_TYPE=current
CATEGORY=S
MAX_PROJECTS=50
TERM=2024-1

# 운영 DB (Oracle Cloud MySQL). 실제 값은 커밋하지 말고 로컬 .env 또는 시크릿으로 주입한다.
DB_HOST=<DB_HOST>
DB_PORT=3306
DB_USER=<DB_USER>
DB_NAME=<DB_NAME>
DB_PASSWORD=<DB_PASSWORD>

# CRAWLER_USER_ID가 비어 있으면 크롤러가 이 시스템 유저를 생성/재사용한다.
CRAWLER_USER_ID=
DB_AUTO_CREATE_CRAWLER_USER=true
CRAWLER_USER_EMAIL=softcon-crawler@example.com
CRAWLER_USER_FIREBASE_UID=softcon-crawler
CRAWLER_USER_NAME=Softcon Crawler

# 배포된 스키마의 테이블명(소문자).
DB_POST_TABLE=posts
DB_USER_TABLE=users

# API 전송 설정.
# BACKEND_API_BASE_URL과 CRAWLER_API_TOKEN이 모두 설정되면 DB 직접 적재 대신 백엔드로 POST한다. 비우면 DB 폴백.
# BACKEND_API_BASE_URL은 https만 허용된다. CRAWLER_API_TOKEN은 시크릿으로 주입한다.
BACKEND_API_BASE_URL=
CRAWLER_API_TOKEN=
