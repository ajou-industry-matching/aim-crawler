LIST_TYPE=current
CATEGORY=S
MAX_PROJECTS=50

# MySQL over TCP, for example Oracle Cloud MySQL.
DB_HOST=
DB_PORT=3306

# MySQL over Cloud Run + Cloud SQL Unix socket.
# CLOUD_SQL_CONNECTION_NAME=ajou-project-cafd9:asia-northeast3:aim-be-db
# DB_UNIX_SOCKET=/cloudsql/ajou-project-cafd9:asia-northeast3:aim-be-db

DB_USER=
DB_PASSWORD=
DB_NAME=

# Existing admin/system user id in the AIM backend USERS table.
CRAWLER_USER_ID=

# Backend entity table name is @Table(name = "POSTS").
# Set to posts if the deployed MySQL schema was created lower-case.
DB_POST_TABLE=POSTS
